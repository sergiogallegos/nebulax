#!/usr/bin/env python3
"""Record macOS PTY lifecycle correctness tests; never a performance benchmark."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import platform
import re
import runpy
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write(path, value):
    path.write_text(json.dumps(value, indent=2) + "\n")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    if sys.platform != "darwin":
        parser.error("real PTY lifecycle recording requires macOS; portable pump tests use cargo test")
    shared = runpy.run_path(str(ROOT / "scripts/replay"))
    run = shared["run"]
    sources = shared["source_manifest"]()
    started = datetime.now(timezone.utc)
    output = args.output or ROOT / "target/pty-session" / started.strftime("%Y%m%dT%H%M%S.%fZ")
    output.mkdir(parents=True, exist_ok=False)
    build = run(["cargo", "test", "-p", "nebulax-pty-session", "--locked", "--no-run", "--message-format=json"], check=False)
    (output / "build.jsonl").write_text(build.stdout)
    (output / "build-stderr.txt").write_text(build.stderr)
    if build.returncode:
        print(build.stderr, file=sys.stderr)
        return build.returncode
    binaries = {}
    for line in build.stdout.splitlines():
        item = json.loads(line)
        if item.get("reason") == "compiler-artifact" and item.get("executable"):
            binaries[item["target"]["name"]] = sha(Path(item["executable"]))
    result = run(["cargo", "test", "-p", "nebulax-pty-session", "--locked", "--", "--test-threads=1"], check=False)
    (output / "tests.txt").write_text(result.stdout)
    (output / "stderr.txt").write_text(result.stderr)
    totals = re.findall(r"test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored", result.stdout)
    stable = sources == shared["source_manifest"]()
    passed = sum(int(p) for p, _, _ in totals)
    success = result.returncode == 0 and passed == 15 and all(f == i == "0" for _, f, i in totals) and stable
    write(output / "summary.json", {
        "schema_version": 1, "kind": "pty_lifecycle_correctness_not_performance",
        "passed": passed, "expected": 15, "success": success,
        "os_specific_tests": 10, "portable_transport_tests": 5,
        "sources_unchanged_during_run": stable, "exit_code": result.returncode,
        "limits": ["one direct child; no shell job-tree supervision", "forced short writes/backpressure use a scripted transport", "no GUI, input encoder or scheduler performance evidence"],
    })
    write(output / "sources.json", sources)
    write(output / "environment.json", {
        "started_utc": started.isoformat(), "finished_utc": datetime.now(timezone.utc).isoformat(),
        "git_commit": run(["git", "rev-parse", "HEAD"]).stdout.strip(),
        "git_dirty": bool(run(["git", "status", "--porcelain"]).stdout),
        "rustc": run(["rustc", "-Vv"]).stdout.strip(), "cargo": run(["cargo", "-V"]).stdout.strip(),
        "python": platform.python_version(), "architecture": platform.machine(),
        "macos": run(["sw_vers"]).stdout.strip(), "xcode": run(["xcodebuild", "-version"]).stdout.strip(),
        "sdk": run(["xcrun", "--sdk", "macosx", "--show-sdk-version"]).stdout.strip(),
        "executables_sha256": binaries, "core_dependencies": run(["cargo", "tree", "--locked", "-p", "nebulax-terminal"]).stdout.strip(),
        "experiment_dependencies": run(["cargo", "tree", "--locked", "-p", "nebulax-pty-session"]).stdout.strip(),
    })
    write(output / "artifacts.json", {p.name: sha(p) for p in sorted(output.iterdir()) if p.is_file()})
    print(f"PTY tests: {passed}/15; success={success}; artifacts: {output}")
    return 0 if success else 1


if __name__ == "__main__":
    sys.exit(main())
