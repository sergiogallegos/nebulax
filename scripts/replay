#!/usr/bin/env python3
"""Build and record the synthetic replay experiment with reproducible provenance."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import platform
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parent.parent


def run(args, *, check=True):
    return subprocess.run(args, cwd=ROOT, capture_output=True, text=True, check=check)


def sha(data):
    return hashlib.sha256(data).hexdigest()


def write_json(path, data):
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")


def source_manifest():
    paths = [ROOT / name for name in ("Cargo.toml", "Cargo.lock", "rust-toolchain.toml", ".python-version")]
    for folder in ("crates", "experiments", "tests", "scripts", "third_party/unicode"):
        paths.extend(p for p in (ROOT / folder).rglob("*") if p.is_file() and "__pycache__" not in p.parts)
    return {str(p.relative_to(ROOT)): sha(p.read_bytes()) for p in sorted(paths)}


def optional_command(args):
    try:
        result = run(args, check=False)
        return result.stdout.strip() if result.returncode == 0 else None
    except FileNotFoundError:
        return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--engine", choices=("alacritty", "owned"), default="alacritty")
    parser.add_argument("--allow-known-gaps", action="store_true", help="Tolerate only reviewed state hashes; gaps remain reported.")
    parser.add_argument("--output", type=Path, help="New artifact directory; existing directories are rejected.")
    args = parser.parse_args()
    if args.engine == "owned" and args.allow_known_gaps:
        parser.error("owned replay has strict scoped expectations; --allow-known-gaps is Alacritty-only")
    package = "nebulax-owned-replay" if args.engine == "owned" else "nebulax-replay"
    started = datetime.now(timezone.utc)
    run_id = started.strftime("%Y%m%dT%H%M%S.%fZ")
    output = args.output or ROOT / "target" / "replay" / run_id
    if not output.is_absolute():
        output = Path.cwd() / output
    output.mkdir(parents=True, exist_ok=False)
    sources = source_manifest()
    build = run(["cargo", "build", "--locked", "-p", package, "--message-format=json"], check=False)
    if build.returncode:
        (output / "build.log").write_text(build.stdout + build.stderr)
        print(build.stderr, file=sys.stderr)
        print(f"Build failed; details in {output / 'build.log'}", file=sys.stderr)
        return 2
    executable = None
    for line in build.stdout.splitlines():
        message = json.loads(line)
        if message.get("reason") == "compiler-artifact" and message.get("target", {}).get("name") == package and message.get("executable"):
            executable = Path(message["executable"])
    if executable is None:
        raise RuntimeError("Cargo did not report the replay executable")
    command = [str(executable)] + (["--allow-known-gaps"] if args.allow_known_gaps else [])
    result = run(command, check=False)
    (output / "replay.json").write_text(result.stdout)
    (output / "stderr.txt").write_text(result.stderr)
    report = json.loads(result.stdout)
    lock = tomllib.loads((ROOT / "Cargo.lock").read_text())
    packages = [{k: p[k] for k in ("name", "version", "source", "checksum") if k in p} for p in lock["package"]]
    engine = [p for p in packages if p["name"] == report["engine"]]
    if len(engine) != 1 or engine[0]["version"] != report["engine_version"]:
        raise RuntimeError("reported engine does not match Cargo.lock")
    if report["corpus_sha256"] != sources["tests/fixtures/terminal-replay.json"]:
        raise RuntimeError("compiled fixture hash does not match the recorded input")
    stable_sources = sources == source_manifest()
    write_json(output / "sources.json", sources)
    write_json(output / "dependencies.json", packages)
    metadata = {
        "schema_version": 1, "run_id": run_id,
        "started_utc": started.isoformat(), "finished_utc": datetime.now(timezone.utc).isoformat(),
        "measurement_kind": "headless_correctness_not_performance",
        "git_commit": run(["git", "rev-parse", "HEAD"]).stdout.strip(),
        "git_dirty": bool(run(["git", "status", "--porcelain", "--untracked-files=all"]).stdout),
        "source_manifest_sha256": sha((output / "sources.json").read_bytes()),
        "sources_unchanged_during_run": stable_sources,
        "executable_sha256": sha(executable.read_bytes()),
        "cargo_lock_sha256": sources["Cargo.lock"], "corpus_sha256": report["corpus_sha256"],
        "rustc": run(["rustc", "-Vv"]).stdout.strip(), "cargo": run(["cargo", "-V"]).stdout.strip(),
        "python": platform.python_version(), "os": platform.system(), "kernel_release": platform.release(),
        "architecture": platform.machine(), "macos": optional_command(["sw_vers"]),
        "xcode": optional_command(["xcodebuild", "-version"]) if sys.platform == "darwin" else None,
        "macos_sdk_version": optional_command(["xcrun", "--sdk", "macosx", "--show-sdk-version"]) if sys.platform == "darwin" else None,
        "macos_sdk_build": optional_command(["xcrun", "--sdk", "macosx", "--show-sdk-build-version"]) if sys.platform == "darwin" else None,
        "cpu": optional_command(["sysctl", "-n", "machdep.cpu.brand_string"]) if sys.platform == "darwin" else None,
        "ram_bytes": optional_command(["sysctl", "-n", "hw.memsize"]) if sys.platform == "darwin" else None,
        "build_profile": "dev", "process_scope": "single headless replay process; no child shell",
        "completion_condition": "snapshot after each fixture operation for every delivery variant",
        "timing_claim": None, "warmups": 0,
        "replay_count": sum(f["replay_count"] for f in report["results"]),
        "allow_known_gaps": args.allow_known_gaps, "exit_code": result.returncode,
        "selected_engine": args.engine,
        "owned_engine_dependency_tree": optional_command(["cargo", "tree", "--locked", "-p", "nebulax-terminal"]) if args.engine == "owned" else None,
        "not_applicable": ["display", "font", "GPU", "shell", "power/thermal benchmark controls"],
    }
    write_json(output / "environment.json", metadata)
    hashes = {p.name: sha(p.read_bytes()) for p in sorted(output.iterdir()) if p.is_file()}
    write_json(output / "artifacts.json", hashes)
    if not stable_sources:
        print("Sources changed during the run; results are invalid.", file=sys.stderr)
        return 2
    for fixture in report["results"]:
        if args.engine == "owned":
            print(f"{fixture['status'].upper()}: {fixture['id']} ({fixture['replay_count']} replays)" +
                  (f" — {fixture['reason']}" if fixture['status'] == "pending" else ""))
            continue
        status = "OBSERVED GAP" if fixture["expectation_errors"] else "MATCH"
        if fixture["equivalence_errors"]:
            status = "CHUNK MISMATCH"
        print(f"{status}: {fixture['id']} ({fixture['replay_count']} replays)")
    print(f"Artifacts: {output}")
    return result.returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"replay recording failed: {error}", file=sys.stderr)
        sys.exit(2)
